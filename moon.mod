name = "mizchi/x"

version = "0.6.0"

import {
  "moonbitlang/async@0.20.5",
  "moonbitlang/x@0.4.50",
  "moonbitlang/regexp@0.3.5",
}

readme = "README.md"

repository = "https://github.com/mizchi/x"

license = "Apache-2.0"

keywords = [
  "moonbit",
  "async",
  "backend",
  "compatibility",
  "nodejs",
  "process",
  "filesystem",
  "http",
  "gzip",
  "tls",
  "socket",
  "tcp",
  "udp",
  "signal",
  "raw-fd",
  "queue",
  "semaphore",
  "websocket",
  "wasi",
  "bytes",
  "bytes-view",
  "string-view",
  "array-view",
  "simd",
]

description = "Cross-platform MoonBit compatibility facades with native delegation and accelerated JS implementations for async IO, bytes, regexp, and JSON."

preferred_target = "native"

source = "src"
